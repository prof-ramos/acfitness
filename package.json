{
  "name": "acfitness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:generated": "pnpm generate && test -z \"$(git status --porcelain --untracked-files=all -- packages/contracts/openapi.json packages/api-client/src/generated)\"",
    "dev": "turbo run dev --filter=@acfitness/web",
    "generate": "pnpm --filter @acfitness/contracts generate:openapi && pnpm --filter @acfitness/api-client generate",
    "generate:openapi": "pnpm --filter @acfitness/contracts generate:openapi",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hey-api/openapi-ts": "0.99.0",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
